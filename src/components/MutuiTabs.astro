---
import Icon from './Icon.astro';
import BottomSheet from './BottomSheet.astro';
import { CREDIPASS_CTA_URL, CONTACT } from '../config/seo';
import { getDictionary } from '../utils/i18n';
import type { Locale } from '../config/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="mutui" class="section bg-navy text-white relative overflow-hidden">
  <div class="absolute inset-0 pattern-dots opacity-30 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-0 right-0 h-80 w-80 rounded-full bg-gold-gradient opacity-10 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="max-w-2xl" data-reveal>
      <span class="eyebrow on-dark">{t.mutui.eyebrow}</span>
      <h2 class="mt-3 sm:mt-4 font-display text-display-md sm:text-display-lg text-white">{t.mutui.title}</h2>
      <p class="mt-3 sm:mt-4 text-white/75 text-base sm:text-lg leading-relaxed">{t.mutui.subtitle}</p>
    </div>

    <!-- MOBILE: card carousel with bottom-sheet -->
    <div class="mt-8 lg:hidden -mx-5 sm:-mx-8">
      <div class="carousel-h carousel-edge-fade px-5 sm:px-8">
        {t.mutui.items.map((m) => (
          <button
            type="button"
            data-open-sheet={`sheet-mutuo-${m.id}`}
            class="text-left w-[80%] xs:w-[70%] sm:w-[46%] rounded-2xl border border-white/15 bg-white/5 p-5 active:bg-white/10 transition-colors backdrop-blur-sm relative"
          >
            {m.recommended && (
              <span class="absolute -top-2 left-5 badge-recommended">
                ★ {t.mutui.recommended}
              </span>
            )}
            <div class="text-[10px] uppercase tracking-[0.18em] text-gold-300 font-semibold">{m.shortTitle}</div>
            <h3 class="mt-2 font-display text-lg text-white">{m.title}</h3>
            <p class="mt-2 text-[13px] text-white/75 leading-snug">{m.tagline}</p>
            <div class="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-gold-300">
              {t.mutui.ctaCalcola}
              <Icon name="chevron-right" size={11} strokeWidth={3} />
            </div>
          </button>
        ))}
      </div>
      <p class="swipe-hint px-5 sm:px-8 text-white/55">{t.mutui.swipeHint}</p>
    </div>

    <!-- DESKTOP: tab interface -->
    <div class="mt-12 hidden lg:block" data-tabs>
      <div
        class="flex flex-wrap gap-2"
        role="tablist"
        aria-label="Tipologie di mutuo"
      >
        {t.mutui.items.map((m, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${m.id}`}
            aria-controls={`panel-${m.id}`}
            aria-selected={i === 1 ? 'true' : 'false'}
            tabindex={i === 1 ? 0 : -1}
            class="relative whitespace-nowrap rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-white/80 hover:text-white hover:border-white/40 aria-selected:bg-gold-gradient aria-selected:text-navy aria-selected:border-transparent aria-selected:shadow-gold transition-colors"
            data-tab-trigger
          >
            {m.shortTitle}
            {m.recommended && (
              <span class="ml-1.5 text-[9px] font-bold uppercase tracking-wider" aria-label={t.mutui.recommended}>★</span>
            )}
          </button>
        ))}
      </div>

      <div class="mt-10 grid grid-cols-[1.1fr,0.9fr] gap-12">
        {t.mutui.items.map((m, i) => (
          <div
            id={`panel-${m.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${m.id}`}
            class:list={['col-span-full grid grid-cols-[1.1fr,0.9fr] gap-12', i !== 1 && 'hidden']}
            data-tab-panel
          >
            <div data-reveal>
              {m.recommended && (
                <span class="badge-recommended mb-4">
                  ★ {t.mutui.recommended}
                </span>
              )}
              <h3 class="font-display text-3xl xl:text-4xl text-white">{m.title}</h3>
              <p class="mt-3 text-gold-300 text-base">{m.tagline}</p>
              <p class="mt-5 text-white/80 leading-relaxed text-[17px]">{m.body}</p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href={CREDIPASS_CTA_URL} target="_blank" rel="noopener" class="btn-on-dark-primary">
                  {t.mutui.ctaCalcola}
                  <Icon name="chevron-right" size={14} strokeWidth={3} />
                </a>
                <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="btn-on-dark-secondary">
                  <Icon name="whatsapp" size={16} />
                  {t.nav.whatsapp}
                </a>
              </div>
            </div>
            <div data-reveal style="transition-delay:120ms">
              <ul class="rounded-2xl border border-white/15 bg-white/5 p-6 space-y-4">
                {m.bullets.map((b) => (
                  <li class="flex items-start gap-3 text-white/85 text-sm">
                    <span class="mt-1 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gold-gradient text-navy">
                      <Icon name="check" size={10} strokeWidth={4} />
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Mobile sheets for mutui -->
  {t.mutui.items.map((m) => (
    <BottomSheet
      id={`sheet-mutuo-${m.id}`}
      title={m.title}
      eyebrow={m.shortTitle}
      closeLabel={t.services.closeDetail}
    >
      {m.recommended && (
        <span class="badge-recommended">★ {t.mutui.recommended}</span>
      )}
      <p class={`text-gold-700 text-sm font-medium ${m.recommended ? 'mt-3' : ''}`}>{m.tagline}</p>
      <p class="mt-3 text-ink/80 leading-relaxed">{m.body}</p>
      <ul class="mt-5 space-y-3">
        {m.bullets.map((b) => (
          <li class="flex items-start gap-3 text-sm text-ink/85">
            <span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gold-gradient text-navy">
              <Icon name="check" size={10} strokeWidth={4} />
            </span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
      <div slot="footer" class="sheet-footer flex flex-col sm:flex-row gap-2">
        <a href={CREDIPASS_CTA_URL} target="_blank" rel="noopener" class="btn-primary flex-1">
          {t.mutui.ctaCalcola}
          <Icon name="chevron-right" size={12} strokeWidth={3} />
        </a>
        <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="btn btn-secondary flex-1">
          <Icon name="whatsapp" size={16} />
          {t.nav.whatsapp}
        </a>
      </div>
    </BottomSheet>
  ))}
</section>

<script is:inline>
  (() => {
    const wrap = document.querySelector('[data-tabs]');
    if (!wrap) return;
    const triggers = Array.from(wrap.querySelectorAll('[data-tab-trigger]'));
    const panels = Array.from(wrap.querySelectorAll('[data-tab-panel]'));
    const activate = (i) => {
      triggers.forEach((t, idx) => {
        const sel = idx === i;
        t.setAttribute('aria-selected', String(sel));
        t.setAttribute('tabindex', sel ? '0' : '-1');
      });
      panels.forEach((p, idx) => p.classList.toggle('hidden', idx !== i));
    };
    triggers.forEach((t, i) => {
      t.addEventListener('click', () => activate(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + triggers.length) % triggers.length;
          triggers[next].focus();
          activate(next);
        }
      });
    });
  })();
</script>
