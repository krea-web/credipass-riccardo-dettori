---
import Icon from './Icon.astro';
import { getDictionary } from '../utils/i18n';
import type { Locale } from '../config/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="section bg-offwhite">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <span class="eyebrow">{t.authority.eyebrow}</span>
      <h2 class="mt-3 sm:mt-4 h-section">{t.authority.title}</h2>
      <p class="mt-3 sm:mt-4 lead">{t.authority.intro}</p>
    </div>

    <!-- Trust badges with hierarchy: Credipass = primary (center, larger) -->
    <div class="mt-10 sm:mt-14 grid sm:grid-cols-3 gap-4 sm:gap-5 items-stretch">
      {t.authority.badges.map((badge, i) => {
        const isPrimary = badge.weight === 'primary';
        return (
          <article
            class:list={[
              'rounded-2xl p-6 sm:p-7 transition-all duration-300',
              isPrimary
                ? 'bg-navy text-white border border-navy shadow-lift sm:scale-[1.04] sm:-my-2 relative z-10'
                : 'bg-white border border-navy/8 shadow-soft hover:shadow-lift',
            ]}
            data-reveal
            style={`transition-delay:${i * 90}ms`}
          >
            <div class="flex items-center gap-3">
              <div
                class:list={[
                  'h-10 w-10 rounded-full flex items-center justify-center',
                  isPrimary ? 'bg-gold-gradient text-navy' : 'border-2 border-gold text-gold-700',
                ]}
              >
                <Icon name={i === 0 ? 'badge-check' : i === 1 ? 'shield' : 'trending-up'} size={18} strokeWidth={2.4} />
              </div>
              <div
                class:list={[
                  'text-[11px] uppercase tracking-[0.18em] font-semibold',
                  isPrimary ? 'text-gold-300' : 'text-muted',
                ]}
              >
                {badge.subtitle}
              </div>
            </div>
            <h3
              class:list={[
                'mt-5 font-display font-semibold',
                isPrimary ? 'text-2xl text-white' : 'text-xl text-navy',
              ]}
            >
              {badge.title}
            </h3>
            <p
              class:list={[
                'mt-3 text-sm leading-relaxed',
                isPrimary ? 'text-white/80' : 'text-ink/65',
              ]}
            >
              {badge.body}
            </p>
          </article>
        );
      })}
    </div>

    <!-- "Why a broker" with highlighted lead words -->
    <div class="mt-14 sm:mt-16 max-w-3xl mx-auto" data-reveal>
      <h3 class="font-display text-2xl sm:text-3xl text-navy text-center">{t.authority.whyTitle}</h3>
      <ul class="mt-6 sm:mt-8 grid sm:grid-cols-2 gap-4 sm:gap-5">
        {t.authority.whyBullets.map((b) => (
          <li class="flex items-start gap-3 rounded-xl bg-white p-4 sm:p-5 border border-navy/5">
            <span class="mt-1 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gold-gradient text-navy">
              <Icon name="check" size={11} strokeWidth={4} />
            </span>
            <p class="text-sm text-ink/80 leading-relaxed">
              <strong class="text-navy font-semibold">{b.highlight}:</strong> {b.body}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
