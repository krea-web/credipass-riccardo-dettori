---
import Icon from './Icon.astro';
import { CONTACT, CREDIPASS_CTA_URL } from '../config/seo';
import { getDictionary } from '../utils/i18n';
import type { Locale } from '../config/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<div
  class="mobile-bar"
  data-mobile-bar
  aria-label="Quick contact actions"
  role="region"
>
  <div class="flex items-stretch gap-2">
    <a
      href={CONTACT.whatsappHref}
      target="_blank"
      rel="noopener"
      aria-label={t.nav.whatsapp}
      class="flex-1 inline-flex flex-col items-center justify-center gap-0.5 rounded-xl bg-[#25D366] text-white py-2 px-1 active:scale-[0.97] transition-transform"
    >
      <Icon name="whatsapp" size={20} />
      <span class="text-[10px] font-semibold uppercase tracking-wider">{t.nav.whatsapp}</span>
    </a>
    <a
      href={CONTACT.phoneHref}
      aria-label={t.nav.call}
      class="flex-1 inline-flex flex-col items-center justify-center gap-0.5 rounded-xl bg-navy text-white py-2 px-1 active:scale-[0.97] transition-transform"
    >
      <Icon name="phone" size={18} />
      <span class="text-[10px] font-semibold uppercase tracking-wider">{t.nav.call}</span>
    </a>
    <a
      href={CREDIPASS_CTA_URL}
      target="_blank"
      rel="noopener"
      class="flex-[1.6] inline-flex items-center justify-center gap-1.5 rounded-xl bg-gold-gradient text-navy font-bold py-2 px-3 text-sm active:scale-[0.97] transition-transform shadow-gold"
    >
      <span>{t.nav.cta}</span>
      <Icon name="arrow-right" size={14} strokeWidth={2.5} />
    </a>
  </div>
</div>

<script is:inline>
  (() => {
    const bar = document.querySelector('[data-mobile-bar]');
    if (!bar) return;
    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;
    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      bar.classList.add('is-visible');
      document.body.classList.add('has-bottom-bar');
    };
    const hide = () => {
      if (!revealed) return;
      revealed = false;
      bar.classList.remove('is-visible');
      document.body.classList.remove('has-bottom-bar');
    };
    const update = () => {
      if (isDesktop()) { hide(); return; }
      // Reveal after scrolling past hero (~ first viewport height)
      if (window.scrollY > Math.min(380, window.innerHeight * 0.6)) reveal();
      else hide();
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  })();
</script>
