---
import Icon from './Icon.astro';
import { getDictionary } from '../utils/i18n';
import type { Locale } from '../config/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);

const categoryKeys = ['costi', 'tempi', 'requisiti', 'procedura'] as const;

/** Render **bold** segments as <strong>, single pass, no XSS surface
 *  because content is authored copy, not user input. */
function renderAnswer(html: string): string {
  return html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<section id="faq" class="section bg-offwhite">
  <div class="container-page">
    <div class="max-w-2xl mx-auto text-center" data-reveal>
      <span class="eyebrow justify-center inline-flex">{t.faq.eyebrow}</span>
      <h2 class="mt-3 sm:mt-4 h-section">{t.faq.title}</h2>
      <p class="mt-3 sm:mt-4 lead">{t.faq.subtitle}</p>
    </div>

    <!-- Category filter chips -->
    <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-2" role="tablist" aria-label="FAQ categories" data-faq-filters>
      <button
        type="button"
        class="rounded-full border border-navy/15 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wider text-navy aria-pressed:bg-navy aria-pressed:text-white aria-pressed:border-navy transition-colors"
        aria-pressed="true"
        data-faq-filter="all"
      >
        Tutte
      </button>
      {categoryKeys.map((c) => (
        <button
          type="button"
          class="rounded-full border border-navy/15 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wider text-navy/70 hover:text-navy aria-pressed:bg-navy aria-pressed:text-white aria-pressed:border-navy transition-colors"
          aria-pressed="false"
          data-faq-filter={c}
        >
          {t.faq.categories[c]}
        </button>
      ))}
    </div>

    <div class="mt-8 sm:mt-10 max-w-3xl mx-auto space-y-3" data-faq>
      {t.faq.items.map((item) => (
        <details
          class="group rounded-2xl border border-navy/8 bg-white px-5 sm:px-6 py-4 sm:py-5 open:shadow-soft open:border-gold-300 transition-all"
          data-faq-item
          data-cat={item.cat}
        >
          <summary class="flex items-start gap-4 cursor-pointer list-none">
            <div class="flex-1 min-w-0">
              <div class="text-[10px] uppercase tracking-[0.18em] text-gold-700 font-semibold mb-1">
                {t.faq.categories[item.cat as keyof typeof t.faq.categories]}
              </div>
              <h3 class="font-display text-base sm:text-lg font-semibold text-navy">{item.q}</h3>
            </div>
            <span class="mt-1 flex-none h-8 w-8 rounded-full border border-navy/15 flex items-center justify-center text-navy/70 group-open:bg-gold-gradient group-open:text-navy group-open:border-transparent transition-colors">
              <Icon name="plus" size={14} strokeWidth={2.5} class="group-open:rotate-45 transition-transform duration-200" />
            </span>
          </summary>
          <div class="faq-answer mt-4 text-sm sm:text-[15px] text-ink/75 leading-relaxed" set:html={renderAnswer(item.a)} />
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const items = document.querySelectorAll('[data-faq-item]');
    const filters = document.querySelectorAll('[data-faq-filter]');

    // Single-open accordion behaviour
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          items.forEach((other) => { if (other !== item) other.removeAttribute('open'); });
        }
      });
    });

    // Category filter
    filters.forEach((f) => {
      f.addEventListener('click', () => {
        const cat = f.getAttribute('data-faq-filter');
        filters.forEach((b) => b.setAttribute('aria-pressed', b === f ? 'true' : 'false'));
        items.forEach((item) => {
          const itemCat = item.getAttribute('data-cat');
          const match = cat === 'all' || itemCat === cat;
          item.style.display = match ? '' : 'none';
          if (!match) item.removeAttribute('open');
        });
      });
    });
  })();
</script>
