---
import Icon from './Icon.astro';
import { CONTACT } from '../config/seo';
import { localePath, type Locale } from '../config/i18n';
import { getDictionary } from '../utils/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);

// Replace with your Formspree form ID once issued (e.g. https://formspree.io/f/xxxxxxx).
const FORM_ENDPOINT = 'https://formspree.io/f/REPLACE_ME';
const isConfigured = !FORM_ENDPOINT.includes('REPLACE_ME');

const privacyHref = localePath(locale, 'privacy');
---

<section id="contatti" class="section bg-offwhite">
  <div class="container-page">
    <div class="grid lg:grid-cols-[1.1fr,0.9fr] gap-10 lg:gap-16 items-start">
      <div data-reveal>
        <span class="eyebrow">{t.contact.eyebrow}</span>
        <h2 class="mt-3 sm:mt-4 h-section">{t.contact.title}</h2>
        <p class="mt-3 sm:mt-4 lead">{t.contact.subtitle}</p>

        <div class="mt-8 sm:mt-10 rounded-2xl border border-navy/10 bg-white p-6 sm:p-7">
          <h3 class="font-display text-base sm:text-lg font-semibold text-navy">{t.contact.infoTitle}</h3>
          <ul class="mt-4 sm:mt-5 space-y-2.5 sm:space-y-3">
            <li>
              <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-lg bg-[#25D366]/8 hover:bg-[#25D366]/14 px-4 py-3 transition-colors group">
                <span class="h-9 w-9 rounded-full bg-[#25D366] text-white flex items-center justify-center flex-none">
                  <Icon name="whatsapp" size={16} />
                </span>
                <div class="flex-1 min-w-0">
                  <div class="text-[11px] uppercase tracking-wider text-muted font-semibold">{t.nav.whatsapp}</div>
                  <div class="text-sm font-medium text-navy truncate">{CONTACT.whatsappNumber}</div>
                </div>
                <Icon name="chevron-right" size={14} strokeWidth={2.5} class="text-navy/30 group-hover:text-navy/60 transition-colors" />
              </a>
            </li>
            <li>
              <a href={CONTACT.phoneHref} class="flex items-center gap-3 rounded-lg bg-navy/5 hover:bg-navy/8 px-4 py-3 transition-colors group">
                <span class="h-9 w-9 rounded-full bg-navy text-white flex items-center justify-center flex-none">
                  <Icon name="phone" size={16} />
                </span>
                <div class="flex-1 min-w-0">
                  <div class="text-[11px] uppercase tracking-wider text-muted font-semibold">{t.chiSono.labels.phone}</div>
                  <div class="text-sm font-medium text-navy truncate">{CONTACT.phone}</div>
                </div>
                <Icon name="chevron-right" size={14} strokeWidth={2.5} class="text-navy/30 group-hover:text-navy/60 transition-colors" />
              </a>
            </li>
            <li>
              <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-3 rounded-lg bg-navy/5 hover:bg-navy/8 px-4 py-3 transition-colors group">
                <span class="h-9 w-9 rounded-full bg-navy text-white flex items-center justify-center flex-none">
                  <Icon name="mail" size={16} />
                </span>
                <div class="flex-1 min-w-0">
                  <div class="text-[11px] uppercase tracking-wider text-muted font-semibold">{t.chiSono.labels.email}</div>
                  <div class="text-sm font-medium text-navy truncate">{CONTACT.email}</div>
                </div>
                <Icon name="chevron-right" size={14} strokeWidth={2.5} class="text-navy/30 group-hover:text-navy/60 transition-colors" />
              </a>
            </li>
          </ul>
          <div class="mt-5 pt-4 border-t border-navy/8 flex items-center gap-2 text-xs text-muted">
            <Icon name="clock" size={14} />
            <span>{CONTACT.officeHours}</span>
          </div>
        </div>
      </div>

      {isConfigured ? (
        <form
          action={FORM_ENDPOINT}
          method="POST"
          class="rounded-2xl bg-white border border-navy/10 p-6 sm:p-7 shadow-soft space-y-4"
          data-contact-form
          data-reveal
          style="transition-delay:120ms"
        >
          <div>
            <label for="cf-name" class="text-xs font-semibold uppercase tracking-wider text-muted">{t.contact.form.name} <span class="text-gold-700">*</span></label>
            <input id="cf-name" name="name" type="text" required placeholder={t.contact.form.namePlaceholder}
              class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-navy placeholder:text-muted focus:border-gold-700 focus:ring-0 outline-none" />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="cf-email" class="text-xs font-semibold uppercase tracking-wider text-muted">{t.contact.form.email} <span class="text-gold-700">*</span></label>
              <input id="cf-email" name="email" type="email" required placeholder={t.contact.form.emailPlaceholder}
                class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-navy placeholder:text-muted focus:border-gold-700 focus:ring-0 outline-none" />
            </div>
            <div>
              <label for="cf-phone" class="text-xs font-semibold uppercase tracking-wider text-muted">{t.contact.form.phone}</label>
              <input id="cf-phone" name="phone" type="tel" placeholder={t.contact.form.phonePlaceholder}
                class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-navy placeholder:text-muted focus:border-gold-700 focus:ring-0 outline-none" />
            </div>
          </div>
          <div>
            <label for="cf-topic" class="text-xs font-semibold uppercase tracking-wider text-muted">{t.contact.form.topic}</label>
            <select id="cf-topic" name="topic" class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-navy focus:border-gold-700 focus:ring-0 outline-none">
              {t.contact.form.topicOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>
          <div>
            <label for="cf-message" class="text-xs font-semibold uppercase tracking-wider text-muted">{t.contact.form.message} <span class="text-gold-700">*</span></label>
            <textarea id="cf-message" name="message" required rows="5" placeholder={t.contact.form.messagePlaceholder}
              class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-navy placeholder:text-muted focus:border-gold-700 focus:ring-0 outline-none resize-y"></textarea>
          </div>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <label class="flex items-start gap-2.5 text-xs text-ink/70 leading-snug cursor-pointer">
            <input type="checkbox" name="privacy" required class="mt-0.5 h-4 w-4 rounded border-navy/30 text-gold focus:ring-gold flex-none" />
            <span>
              {t.contact.form.privacyBefore}<a href={privacyHref} class="text-gold-700 font-semibold underline-offset-2 hover:underline">{t.contact.form.privacyLink}</a>{t.contact.form.privacyAfter}.
            </span>
          </label>
          <button type="submit" class="btn-primary w-full !py-4 text-base" data-form-submit>
            <span data-submit-label>{t.contact.form.submit}</span>
            <span class="hidden" data-submit-loading>{t.contact.form.submitting}</span>
          </button>
          <p class="hidden text-sm font-medium text-emerald-600" data-form-success>{t.contact.form.success}</p>
          <p class="hidden text-sm font-medium text-red-600" data-form-error>{t.contact.form.error}</p>
        </form>
      ) : (
        <aside
          class="rounded-2xl bg-white border-2 border-dashed border-gold/40 p-6 sm:p-7 shadow-soft"
          data-reveal
          style="transition-delay:120ms"
        >
          <div class="flex items-center gap-3">
            <span class="h-10 w-10 rounded-full bg-gold/15 text-gold-700 flex items-center justify-center flex-none">
              <Icon name="mail" size={18} />
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold text-navy">{t.contact.form.fallbackTitle}</h3>
              <p class="text-xs text-muted">Form endpoint pending configuration</p>
            </div>
          </div>
          <p class="mt-5 text-sm text-ink/75 leading-relaxed">{t.contact.form.fallbackBody}</p>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="btn-whatsapp">
              <Icon name="whatsapp" size={16} />
              {t.contact.form.fallbackWhatsapp}
            </a>
            <a href={`mailto:${CONTACT.email}`} class="btn-secondary">
              <Icon name="mail" size={16} />
              {t.contact.form.fallbackEmail}
            </a>
          </div>
          <p class="mt-4 text-[11px] text-muted leading-relaxed">
            Sostituisci <code class="bg-navy/5 px-1 rounded text-[10px]">REPLACE_ME</code> in <code class="bg-navy/5 px-1 rounded text-[10px]">ContactForm.astro</code> con l'ID Formspree per attivare il form.
          </p>
        </aside>
      )}
    </div>
  </div>
</section>

{isConfigured && (
  <script is:inline>
    (() => {
      const form = document.querySelector('[data-contact-form]');
      if (!form) return;
      const submitBtn = form.querySelector('[data-form-submit]');
      const labelEl = form.querySelector('[data-submit-label]');
      const loadingEl = form.querySelector('[data-submit-loading]');
      const successEl = form.querySelector('[data-form-success]');
      const errorEl = form.querySelector('[data-form-error]');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        successEl.classList.add('hidden');
        errorEl.classList.add('hidden');
        labelEl.classList.add('hidden');
        loadingEl.classList.remove('hidden');
        submitBtn.disabled = true;
        try {
          const data = new FormData(form);
          const res = await fetch(form.action, {
            method: 'POST', body: data, headers: { Accept: 'application/json' },
          });
          if (res.ok) { form.reset(); successEl.classList.remove('hidden'); }
          else { errorEl.classList.remove('hidden'); }
        } catch (_) { errorEl.classList.remove('hidden'); }
        finally {
          loadingEl.classList.add('hidden');
          labelEl.classList.remove('hidden');
          submitBtn.disabled = false;
        }
      });
    })();
  </script>
)}
