---
import Icon from './Icon.astro';
import BottomSheet from './BottomSheet.astro';
import { CREDIPASS_CTA_URL, CONTACT } from '../config/seo';
import { getDictionary } from '../utils/i18n';
import type { Locale } from '../config/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);

const iconMap: Record<string, string> = {
  prestiti: 'banknote',
  mutui: 'home',
  quinto: 'wallet',
  imprese: 'briefcase',
  rischi: 'shield-alert',
  immobiliare: 'handshake',
  agevolato: 'badge-check',
  famiglia: 'users',
  b2b: 'building',
};
---

<section id="servizi" class="section">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <span class="eyebrow">{t.services.eyebrow}</span>
      <h2 class="mt-3 sm:mt-4 h-section">{t.services.title}</h2>
      <p class="mt-3 sm:mt-4 lead">{t.services.subtitle}</p>
    </div>

    <!-- Mobile: horizontal swipe carousel; Desktop: grid -->
    <div class="mt-8 sm:mt-12 lg:hidden -mx-5 sm:-mx-8">
      <div class="carousel-h carousel-edge-fade px-5 sm:px-8">
        {t.services.items.map((s, i) => (
          <button
            type="button"
            data-open-sheet={`sheet-svc-${s.id}`}
            class="text-left w-[78%] xs:w-[68%] sm:w-[44%] rounded-2xl border border-navy/8 bg-white p-5 transition-colors active:bg-offwhite focus:border-gold-300"
          >
            <div class="flex items-center justify-between">
              <div class="h-11 w-11 rounded-xl bg-navy-50 text-navy flex items-center justify-center">
                <Icon name={iconMap[s.id]} size={22} />
              </div>
              <span class="text-[10px] font-mono text-muted">0{i + 1}</span>
            </div>
            <h3 class="mt-4 font-display text-base font-semibold text-navy">{s.title}</h3>
            <p class="mt-1.5 text-[13px] text-ink/65 leading-snug line-clamp-2">{s.body}</p>
            <div class="mt-3 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-gold-700">
              {t.services.openDetail}
              <Icon name="chevron-right" size={11} strokeWidth={3} />
            </div>
          </button>
        ))}
      </div>
      <p class="swipe-hint px-5 sm:px-8">{t.services.swipeHint}</p>
    </div>

    <!-- Desktop grid -->
    <div class="mt-14 hidden lg:grid grid-cols-3 gap-5">
      {t.services.items.map((s, i) => (
        <button
          type="button"
          data-open-sheet={`sheet-svc-${s.id}`}
          class="text-left group relative rounded-2xl border border-navy/8 bg-white p-7 hover:border-gold-300 hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300"
          data-reveal
          style={`transition-delay:${(i % 3) * 60}ms`}
        >
          <div class="flex items-center justify-between">
            <div class="h-11 w-11 rounded-xl bg-navy-50 text-navy flex items-center justify-center group-hover:bg-gold-gradient group-hover:text-navy transition-colors">
              <Icon name={iconMap[s.id]} size={22} />
            </div>
            <span class="text-[10px] font-mono text-muted">0{i + 1}</span>
          </div>
          <h3 class="mt-5 font-display text-lg font-semibold text-navy">{s.title}</h3>
          <p class="mt-2 text-sm text-ink/65 leading-relaxed">{s.body}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-gold-700 opacity-0 group-hover:opacity-100 transition-opacity">
            {t.services.openDetail}
            <Icon name="chevron-right" size={11} strokeWidth={3} />
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- One bottom-sheet per service -->
  {t.services.items.map((s) => (
    <BottomSheet
      id={`sheet-svc-${s.id}`}
      title={s.title}
      eyebrow={t.services.eyebrow}
      closeLabel={t.services.closeDetail}
    >
      <div class="flex items-start gap-4">
        <div class="flex-none h-12 w-12 rounded-xl bg-gold-gradient text-navy flex items-center justify-center shadow-gold/40 shadow-sm">
          <Icon name={iconMap[s.id]} size={22} />
        </div>
        <p class="text-base text-ink/80 leading-relaxed">{s.body}</p>
      </div>
      <div class="mt-5 pt-5 border-t border-navy/5">
        <p class="text-sm text-ink/75 leading-relaxed">{s.detail}</p>
      </div>
      <div slot="footer" class="sheet-footer flex flex-col sm:flex-row gap-2">
        <a href={CREDIPASS_CTA_URL} target="_blank" rel="noopener" class="btn-primary flex-1">
          {t.mutui.ctaCalcola}
          <Icon name="chevron-right" size={12} strokeWidth={3} />
        </a>
        <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="btn btn-secondary flex-1">
          <Icon name="whatsapp" size={16} />
          {t.nav.whatsapp}
        </a>
      </div>
    </BottomSheet>
  ))}
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
