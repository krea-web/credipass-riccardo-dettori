---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  closeLabel?: string;
  /** Optional eyebrow label above the title (e.g. category) */
  eyebrow?: string;
}

const { id, title, closeLabel = 'Close', eyebrow } = Astro.props;
---

<dialog
  id={id}
  data-sheet
  aria-labelledby={`${id}-title`}
  class="m-0"
>
  <div class="sheet-panel" data-sheet-panel>
    <div class="sheet-handle sm:hidden" aria-hidden="true"></div>
    <header class="sheet-header">
      <div class="min-w-0">
        {eyebrow && <div class="text-[10px] uppercase tracking-[0.18em] font-semibold text-gold-700">{eyebrow}</div>}
        <h3 id={`${id}-title`} class="mt-1 font-display text-xl sm:text-2xl text-navy truncate">{title}</h3>
      </div>
      <button
        type="button"
        class="sheet-close-btn"
        aria-label={closeLabel}
        data-sheet-close
      >
        <Icon name="close" size={20} strokeWidth={2.5} />
      </button>
    </header>
    <div class="sheet-body">
      <slot />
    </div>
    <slot name="footer" />
  </div>
</dialog>
