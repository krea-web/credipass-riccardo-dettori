---
import Icon from './Icon.astro';
import { getDictionary } from '../utils/i18n';
import type { Locale } from '../config/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="section">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <span class="eyebrow">{t.testimonials.eyebrow}</span>
      <h2 class="mt-3 sm:mt-4 h-section">{t.testimonials.title}</h2>
      <p class="mt-3 sm:mt-4 lead">{t.testimonials.subtitle}</p>
    </div>

    <!-- Mobile carousel / desktop grid -->
    <div class="mt-10 sm:mt-14 -mx-5 sm:-mx-8 lg:mx-0">
      <div class="carousel-h carousel-edge-fade px-5 sm:px-8 lg:!grid lg:grid-cols-3 lg:px-0 lg:gap-5">
        {t.testimonials.items.map((review, i) => (
          <article
            class="w-[88%] xs:w-[78%] sm:w-[60%] lg:w-auto rounded-2xl bg-white border border-navy/8 p-6 sm:p-7 shadow-soft hover:shadow-lift transition-shadow"
            data-reveal
            style={`transition-delay:${(i % 3) * 90}ms`}
            itemscope
            itemtype="https://schema.org/Review"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-0.5 text-gold" aria-label={`${review.stars} stelle`}>
                {Array.from({ length: review.stars }).map(() => (
                  <Icon name="star" size={15} filled={true} />
                ))}
              </div>
              <time class="text-[10px] uppercase tracking-wider text-muted font-semibold" itemprop="datePublished">{review.date}</time>
            </div>

            <Icon name="quote" size={26} class="mt-5 text-gold/40" filled={true} />

            <blockquote class="mt-2 text-sm sm:text-[15px] text-ink/80 leading-relaxed" itemprop="reviewBody">
              {review.body}
            </blockquote>

            <footer class="mt-5 pt-4 border-t border-navy/5">
              <div class="font-semibold text-navy text-sm" itemprop="author">{review.name}</div>
              <div class="text-xs text-muted">{review.role}</div>
            </footer>
          </article>
        ))}
      </div>
      <p class="swipe-hint px-5 sm:px-8">{t.testimonials.swipeHint}</p>
    </div>
  </div>
</section>
