---
import Icon from './Icon.astro';
import { CREDIPASS_CTA_URL, CONTACT } from '../config/seo';
import { getDictionary } from '../utils/i18n';
import type { Locale } from '../config/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="relative isolate overflow-hidden bg-navy-grain text-white section">
  <div class="absolute inset-0 pattern-dots opacity-30 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 h-[480px] w-[480px] rounded-full bg-gold-gradient opacity-[0.18] blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container-page relative text-center" data-reveal>
    <span class="eyebrow on-dark justify-center inline-flex">{t.ctaFinal.eyebrow}</span>
    <h2 class="mt-4 sm:mt-5 font-display text-[clamp(2rem,6vw,4.5rem)] leading-[1.05] tracking-tight text-white max-w-3xl mx-auto">
      {t.ctaFinal.title}
      <span class="block text-gold-300">{t.ctaFinal.titleAccent}</span>
    </h2>
    <p class="mt-5 sm:mt-6 text-base sm:text-lg lg:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">{t.ctaFinal.body}</p>

    <a
      href={CREDIPASS_CTA_URL}
      target="_blank"
      rel="noopener"
      class="btn-on-dark-primary mt-8 sm:mt-10 text-base !py-4 !px-7 sm:!py-5 sm:!px-8 w-full sm:w-auto"
    >
      {t.ctaFinal.ctaPrimary}
    </a>

    <p class="mt-4 sm:mt-6 text-xs sm:text-sm text-white/55">{t.ctaFinal.guarantee}</p>

    <!-- Secondary CTAs: phone/WhatsApp for users not ready to go external -->
    <div class="mt-10 sm:mt-12 max-w-md mx-auto">
      <p class="text-sm uppercase tracking-[0.18em] text-white/45 font-semibold">{t.ctaFinal.ctaSecondaryTitle}</p>
      <div class="mt-4 flex flex-col sm:flex-row gap-2.5">
        <a
          href={CONTACT.whatsappHref}
          target="_blank"
          rel="noopener"
          class="flex-1 inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] text-white font-semibold py-3.5 px-5 text-sm hover:bg-[#1DA851] transition-colors"
        >
          <Icon name="whatsapp" size={16} />
          {t.ctaFinal.ctaWhatsapp}
        </a>
        <a
          href={CONTACT.phoneHref}
          class="flex-1 inline-flex items-center justify-center gap-2 rounded-full border border-white/30 text-white font-semibold py-3.5 px-5 text-sm hover:bg-white hover:text-navy transition-colors"
        >
          <Icon name="phone" size={16} />
          {t.ctaFinal.ctaCall}
        </a>
      </div>
    </div>
  </div>
</section>
