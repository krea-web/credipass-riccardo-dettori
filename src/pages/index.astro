---
import { DEFAULT_LOCALE, SITE_URL } from '../config/i18n';
const target = `/${DEFAULT_LOCALE}/`;
---
<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <title>Riccardo Dettori – Mediatore Creditizio Credipass</title>
    <link rel="canonical" href={`${SITE_URL}${target}`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Reindirizzamento a <a href={target}>{target}</a>…</p>
  </body>
</html>
